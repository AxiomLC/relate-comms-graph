# Secrets and personal data — never commit
.env
.env.*
# ...except the committed template, which holds no secrets
!.env.example
*.key
*.pem
secrets.json
token.json
*client_secret*

# User exports / message archives (contain unencrypted personal history)
# The folder itself ships via .gitkeep so a fresh clone has a drop zone.
exports/
spool/*
!spool/.gitkeep
*.zip
*.result.json

# sample_writer reads REAL downloads from in/ and writes fake ones to out/.
# `in/` holds the user's own history (801 MB on this machine, including an 825 MB
# SMS export) and must never be committed. `out/` is generated, contains no real
# data, and is reproducible from `python -m sample_writer` — so it is ignored too,
# to keep diffs readable.
sample_writer/in/*
!sample_writer/in/.gitkeep
sample_writer/out/
sample_writer/schemas/
!sample_writer/schemas/.gitkeep

# ...except the scrubbed test fixtures, which hold no real data and must ship
!tests/fixtures/**/result.json
# The Outlook fixture is the Aspose sample mailbox — 11 demo messages from 2011,
# no real correspondence. A .pst cannot be generated in pure Python, so it ships.
!tests/fixtures/outlook/*.pst

# Relate stores — generated, never source
store/*
*.rl
# ...but the empty folder must exist on a fresh clone
!store/.gitkeep

# Generated sample data — reproducible from `python -m relate_comms sample build`
relate_comms/sample_data/generated/

# Research scratch — npm metadata, doc dumps, library probes. VALUABLE, KEEP ON DISK,
# never committed. Reference material for the graph-library decision (HANDOVER.md §1).
.tmp_research/*
!/.tmp_research/.gitkeep

# ai_visual_graph_tool run artifacts — a payload dump and the last layout's positions.
# Regenerated on every run, and the payload is a slice of the user's real store.
tools/ai_visual_graph_tool/last_payload.json
tools/ai_visual_graph_tool/last_run_positions.json

# Node — dependencies are installed, never committed. `package-lock.json` IS committed,
# so `npm ci` reproduces the exact tree.
node_modules/

# Serena / aider tool state — per-machine caches, not source.
.serena/
# `.aiderignore` IS committed: it is the repo-shape policy the aider map reads.
# (Deliberately no rule for it.)

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Local Ollama model scratch
Modelfile
