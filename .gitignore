# Secrets and personal data — never commit
.env
.env.*
# ...except the committed template, which holds no secrets
!.env.example
*.key
*.pem
secrets.json
token.json
*client_secret*

# User exports / message archives (contain unencrypted personal history)
# The folder itself ships via .gitkeep so a fresh clone has a drop zone.
exports/
spool/*
!spool/.gitkeep
*.zip
*.result.json

# ...except the scrubbed test fixtures, which hold no real data and must ship
!tests/fixtures/**/result.json

# Relate stores — generated, never source
store/*
*.rl
# ...but the empty folder must exist on a fresh clone
!store/.gitkeep

# Generated sample data — reproducible from `python -m relate_comms sample build`
relate_comms/sample_data/generated/

# Research scratch — npm metadata, doc dumps, library probes. VALUABLE, KEEP ON DISK,
# never committed. Reference material for the graph-library decision (UI-Cytoscape.md §2).
.tmp_research/*
!/.tmp_research/.gitkeep

# Node — dependencies are installed, never committed. `package-lock.json` IS committed,
# so `npm ci` reproduces the exact tree.
node_modules/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# OS
Thumbs.db
desktop.ini
.DS_Store

# Local Ollama model scratch
Modelfile
